{
  "name": "@opencrvs/desktop",
  "version": "2.2.0",
  "description": "Proof of concept: the OpenCRVS v2 client as a Tauri desktop app with a local backend",
  "license": "MPL-2.0",
  "private": true,
  "scripts": {
    "build": "node backend/build.mjs",
    "start": "node backend/build.mjs && node --disable-warning=ExperimentalWarning backend/dist/index.cjs --client-dir ../client/build --data-dir .data --port 7300",
    "dev": "node backend/build.mjs && node scripts/prepare-sidecar.mjs && tauri dev",
    "bundle": "node backend/build.mjs && node scripts/prepare-sidecar.mjs && tauri build",
    "test": "vitest run",
    "test:compilation": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@opencrvs/commons": "workspace:*",
    "@trpc/server": "11.8.0",
    "superjson": "1.9.0-0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opencrvs/events": "workspace:*",
    "@tauri-apps/cli": "^2.12.4",
    "@trpc/client": "11.4.3",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/backend/dist"
        ]
      }
    }
  }
}
